# Copy to .env and fill in the placeholders:  cp .env.example .env
#
# app/core/config.py has NO defaults for most of these settings: every
# uncommented key below is required, and the app (and alembic) will not start
# if one is missing. Values here are safe local-development defaults or
# placeholders - never commit real secrets.
#
# Keys are case-insensitive. Empty strings are fine for text values, but
# numbers and booleans must have a value. Never put an inline comment after an
# EMPTY value ("KEY=   # note"): it is read as the value. Comment above instead.

# --- LLM provider -------------------------------------------------------------
LLM_PROVIDER=groq                       # groq | openrouter | ollama
LLM_TEMPERATURE=0.1

# Groq (used when LLM_PROVIDER=groq). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_ENSEMBLE_MODELS=model-a,model-b,model-c   # at least 2, comma-separated
GROQ_ENSEMBLE_JUDGE_MODEL=openai/gpt-oss-120b

# OpenRouter (used when LLM_PROVIDER=openrouter). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct
OPENROUTER_ENSEMBLE_MODELS=model-a,model-b,model-c
OPENROUTER_ENSEMBLE_JUDGE_MODEL=openai/gpt-oss-120b:free
# Optional attribution headers (HTTP-Referer / X-Title)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Ollama (used when LLM_PROVIDER=ollama; compose overrides the URL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llama3.2-vision

# Multi-LLM ensemble
ENSEMBLE_MAX_TOKENS=2000
ENSEMBLE_TIMEOUT_SEC=30

# --- Retrieval / agent --------------------------------------------------------
# Changing EMBEDDING_MODEL changes vector dimensions: re-create collections
# and re-ingest documents afterwards.
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
MAX_AGENT_ITERATIONS=8
MEMORY_WINDOW=10
ENABLE_WEB_SEARCH=true
ENABLE_CALCULATOR=true
WEB_SEARCH_MAX_RESULTS=4

# --- Vector store (compose overrides URL/port) --------------------------------
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_INDEX_NAME=CloudNestDocs
# WEAVIATE_API_KEY=                     # required with the production overlay

# --- Voice ---------------------------------------------------------------------
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en                   # leave unset for auto-detect
ENABLE_VOICE=true
TTS_BACKEND=edge                        # edge | piper
EDGE_TTS_VOICE=en-US-AriaNeural
PIPER_VOICE=en_US-lessac-medium         # currently unused by the code

# --- API / URLs ----------------------------------------------------------------
API_HOST=0.0.0.0                        # currently unused (entrypoint binds $PORT)
API_PORT=8000                           # currently unused
CORS_ORIGINS=["http://localhost:3000"]  # JSON list of exact origins
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# TRUSTED_PROXIES=                      # IPs/CIDRs allowed to set X-Forwarded-For

# --- Database / auth -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://genai:change-me@localhost:5432/genai
JWT_SECRET=change-me-to-a-long-random-secret   # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_LIFETIME_SECONDS=604800

# OAuth (empty = provider not configured)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Email (empty SMTP_USER/SMTP_PASSWORD = emails are skipped with a warning) --
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CloudNest

# --- Observability ---------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Read via os.getenv at runtime --------------------------------------------
# Docker's env_file exports these; for a bare `uvicorn` run, export them in the
# shell as well (a value in .env alone is ignored for these at runtime).
REDIS_URL=redis://localhost:6379/0
COOKIE_SECURE=false                     # true in production (HTTPS)
REQUIRE_EMAIL_VERIFICATION=false
SENTRY_DSN=
ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Compose-only (production overlay; pass with --env-file .env) --------------
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=                       # URL-safe characters only
